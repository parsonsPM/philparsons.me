  <rect width="32" height="32" rx="9" fill="var(--inverse)"></rect>
  <path
    d="M11.5 22.5V9.5h5.5a4.25 4.25 0 0 1 0 8.5h-5.5"
    stroke="var(--accent)"
    stroke-width="2.6"
    stroke-linecap="round"
